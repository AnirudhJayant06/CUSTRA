{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "REPLACE_WITH_CLOUD_RUN_SERVICE",
          "region": "REPLACE_WITH_CLOUD_RUN_REGION"
        }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
